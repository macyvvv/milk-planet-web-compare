# Local development only. Production must use a persistent libSQL database URL.
DATABASE_URL="file:./dev.db"

# Required for authenticated remote libSQL/Turso connections; omit for local file databases.
DATABASE_AUTH_TOKEN=""

# Name of the HttpOnly session cookie.
SESSION_COOKIE_NAME="mp_session"

NODE_ENV="development"

# Proposal preview only. On Vercel, point DATABASE_URL at file:/tmp/branch101-demo.db,
# enable this flag, and set a four-digit PIN. Data is disposable and instance-local.
EPHEMERAL_SQLITE_DEMO="0"
DEMO_ADMIN_PIN=""
DEMO_SESSION_SECRET=""
